# Copy to .env for `node dev-server.js`, or add these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit the real values.

# SMM panel (orders are paid from your panel balance)
SMM_API_URL=https://smmzio.com/api/v2
SMM_API_KEY=

# Supabase (customer logins + wallets). Project Settings -> API.
# The service role key is secret: only put it in Vercel / .env, never in the page.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# UPI payments straight to your bank account (see README -> Setting up UPI payments)
# The UPI ID customers pay, and the name their UPI app shows
UPI_ID=
UPI_NAME=Boostly
# The Gmail inbox that gets your bank's UPI credit alerts, and a Google App Password for it
# (Google Account -> Security -> 2-Step Verification on -> App passwords). Not your Gmail password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional: only trust alerts from your bank, e.g. alerts@hdfcbank.net or sbi.co.in (default: common Indian banks)
UPI_ALERT_SENDERS=
# How long a payment QR stays valid, in minutes
UPI_QR_MINUTES=10

# Your margin on top of the panel price, in percent (0 = sell at panel price)
MARKUP_PERCENT=80
# Round selling prices up to tidy numbers, e.g. 0.288 -> 0.30 (0 = off)
ROUND_PRICES=1
# Rupees per 1 unit of the panel currency. smmzio accounts are in USD; keep this a little above the
# day's rate (about 96 in Oct 2026) so a weaker rupee doesn't eat your margin.
PANEL_TO_INR_RATE=98

STORE_NAME=Boostly
# Shown when something needs a human, e.g. a WhatsApp number or email
SUPPORT_CONTACT=

# Optional: emails that always get the admin panel (/admin) as owners, comma-separated.
# More people can be added from the admin panel's Team & access page.
ADMIN_EMAILS=

# Gradual delivery: Supabase's scheduler calls /api/drip with "Authorization: Bearer <CRON_SECRET>".
# Use a long random value and put the same one in supabase/drip_scheduler.sql.
CRON_SECRET=
