# Copy to .env for `node dev-server.js`, or add these in Vercel -> Project -> Settings -> Environment Variables.
# Never commit the real values.

# SMM panel (orders are paid from your panel balance)
SMM_API_URL=https://smmzio.com/api/v2
SMM_API_KEY=

# Supabase (customer logins + wallets). Project Settings -> API.
# The service role key is secret: only put it in Vercel / .env, never in the page.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (dashboard.razorpay.com -> Account & Settings -> API Keys). Use rzp_test_ keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Razorpay -> Webhooks -> https://YOUR-SITE/api/webhook, event payment.captured (credits a recharge if the customer closes the tab)
RAZORPAY_WEBHOOK_SECRET=

# Your margin on top of the panel price, in percent (0 = sell at panel price)
MARKUP_PERCENT=80
# Round selling prices up to tidy numbers, e.g. 0.288 -> 0.30 (0 = off)
ROUND_PRICES=1
# Added to wallet recharges to cover Razorpay: 2% + 18% GST = 2.36 (0 = you absorb it)
RAZORPAY_FEE_PERCENT=2.36
# Rupees per 1 unit of the panel currency. smmzio accounts are in USD; keep this a little above the
# day's rate (about 96 in Oct 2026) so a weaker rupee doesn't eat your margin.
PANEL_TO_INR_RATE=98

STORE_NAME=Boostly
# Shown when something needs a human, e.g. a WhatsApp number or email
SUPPORT_CONTACT=
